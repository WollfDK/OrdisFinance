<Window x:Class="OrdisFinance.UI.JanelaRegistrosCofre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MINI-ORDIS // SLOT TÁTICO 2: CENTRAL DE REGISTROS DO COFRE" Height="750" Width="1180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Consolas, Segoe UI">

    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="#060609" BorderBrush="#152232" BorderThickness="1" CornerRadius="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="4" Margin="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00F0FF" Offset="0.0"/>
                                                            <GradientStop Color="#00FF66" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonGreenButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.8" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00FF66" Offset="0.0"/>
                                    <GradientStop Color="#00E5FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF66" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#0D2216"/>
                                <Setter Property="Foreground" Value="#B3FFD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonCyanButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.6" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00F0FF" Offset="0.0"/>
                                    <GradientStop Color="#7000FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#0B1C26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonRedButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.5" BorderBrush="#FF0055" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#260B15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF0055"/>
                                <Setter Property="Foreground" Value="#08080C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BordaCombo" Background="#060609" BorderBrush="#1F293A" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00F0FF"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BordaCombo" Property="BorderBrush" Value="#00F0FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="8,5,22,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <Border Background="#08080C" BorderThickness="1" BorderBrush="#00F0FF" CornerRadius="4">
                                        <ScrollViewer Margin="2">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#08080C"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D2636"/>
                                <Setter Property="Foreground" Value="#00FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#08080C" BorderBrush="#00F0FF" BorderThickness="1.8" CornerRadius="6" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE TITULO ESCURA -->
            <Border Grid.Row="0" Background="#050508" BorderBrush="#1A2636" BorderThickness="0,0,0,1" CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown" Padding="14,0,8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗄" Foreground="#00FF66" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="MINI-ORDIS // SLOT TÁTICO 2: REGISTROS CONFIRMADOS NO COFRE CRIPTOGRAFADO &amp; AUDITORIA" Foreground="#00F0FF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✖" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnFechar_Click"/>
                </Grid>
            </Border>

            <!-- BARRA DE FILTROS AVANCADOS -->
            <Border Grid.Row="1" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="16,12,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Buscar (Estabelecimento / Final Cartão / Valor):" Foreground="#8AA4C0" FontSize="10.5"/>
                        <TextBox x:Name="TxtBuscaCofre" TextChanged="Filtro_Changed" Margin="0,2,0,0" ToolTip="Ex: Final 8515, CASA GRANDE, UNIASSELVI, 281,73"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Mês:" Foreground="#8AA4C0" FontSize="10.5"/>
                        <ComboBox x:Name="ComboFiltroMes" SelectionChanged="Filtro_Changed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Ano:" Foreground="#8AA4C0" FontSize="10.5"/>
                        <ComboBox x:Name="ComboFiltroAno" SelectionChanged="Filtro_Changed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Categoria:" Foreground="#8AA4C0" FontSize="10.5"/>
                        <ComboBox x:Name="ComboFiltroCategoria" SelectionChanged="Filtro_Changed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Método Pagamento / Tipo:" Foreground="#8AA4C0" FontSize="10.5"/>
                        <ComboBox x:Name="ComboFiltroMetodo" SelectionChanged="Filtro_Changed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="5" Content="↺ LIMPAR FILTROS" Style="{StaticResource NeonCyanButton}" Click="BtnLimparFiltros_Click" VerticalAlignment="Bottom" Padding="10,6" FontSize="11"/>
                </Grid>
            </Border>

            <!-- FAIXA DE TELEMETRIA DO FILTRO ATUAL -->
            <Border Grid.Row="2" Background="#0A0E17" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="5" Padding="12,7" Margin="16,0,16,8">
                <Grid>
                    <TextBlock x:Name="TxtResumoFiltroEsquerda" Text="EXIBINDO: 0 REGISTROS CONFIRMADOS NO COFRE" Foreground="#00FF66" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtResumoFiltroDireita" Text="SAÍDAS NO FILTRO: R$ 0,00 | ENTRADAS: R$ 0,00 | MAIOR GASTO: R$ 0,00" Foreground="#00F0FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- LISTA DE REGISTROS CONFIRMADOS NO COFRE -->
            <Border Grid.Row="3" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="6" Padding="10" Margin="16,0,16,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#121622" Padding="10,6" CornerRadius="4,4,0,0" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DATA" Foreground="#00F0FF" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="TIPO" Foreground="#00F0FF" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="DESCRIÇÃO / ESTABELECIMENTO / CARTÃO" Foreground="#00F0FF" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="CATEGORIA" Foreground="#00F0FF" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="4" Text="PAGAMENTO" Foreground="#00F0FF" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="5" Text="VALOR (R$)" Foreground="#00F0FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ListaTransacoesCofre" Grid.Row="1" Background="#08080C" BorderThickness="0"
                             SelectionMode="Extended"
                             SelectionChanged="ListaTransacoesCofre_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,1.5"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="#0A0A10" BorderBrush="#152030" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#0E2232"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="#00F0FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#102C20"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="#00FF66"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="145"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DataTexto}" Foreground="#8AA4C0" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding FundoTipo}" BorderBrush="{Binding CorTipo}" BorderThickness="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TipoBadge}" Foreground="{Binding CorTipo}" FontWeight="Bold" FontSize="10"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DescricaoExibicao}" Foreground="#E0F8FF" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Categoria}" Foreground="#00F0FF" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding FormaPagamento}" Foreground="#D0E8FF" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding ValorFormatado}" Foreground="{Binding CorValor}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- BARRA DE EDICAO RAPIDA DO REGISTRO SELECIONADO -->
            <Border Grid.Row="4" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="16,0,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Editar Descrição Selecionada:" Foreground="#00FF66" FontSize="10.5" FontWeight="Bold"/>
                        <TextBox x:Name="TxtEditDescCofre" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Valor (R$):" Foreground="#00FF66" FontSize="10.5" FontWeight="Bold"/>
                        <TextBox x:Name="TxtEditValCofre" Margin="0,2,0,0"
                                 PreviewTextInput="ApenasDigitos_PreviewTextInput"
                                 TextChanged="TxtEditValCofre_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Data:" Foreground="#00FF66" FontSize="10.5" FontWeight="Bold"/>
                        <TextBox x:Name="TxtEditDataCofre" Margin="0,2,0,0" MaxLength="10"
                                 PreviewTextInput="ApenasDigitos_PreviewTextInput"
                                 TextChanged="TxtEditDataCofre_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Categoria:" Foreground="#00F0FF" FontSize="10.5" FontWeight="Bold"/>
                        <ComboBox x:Name="ComboEditCatCofre" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Forma Pagamento:" Foreground="#00F0FF" FontSize="10.5" FontWeight="Bold"/>
                        <ComboBox x:Name="ComboEditFormaCofre" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="5" Content="✔ SALVAR EDIÇÃO" Style="{StaticResource NeonGreenButton}" Click="BtnSalvarEdicaoCofre_Click" VerticalAlignment="Bottom" Padding="14,7" FontSize="11.5"/>
                </Grid>
            </Border>

            <!-- RODAPE DE ACOES DO COFRE -->
            <Border Grid.Row="5" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="0,1,0,0" CornerRadius="0,0,5,5" Padding="16,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📄 EXPORTAR RELATÓRIO (.CSV)" Style="{StaticResource NeonCyanButton}" Click="BtnExportarCsv_Click" Margin="0,0,12,0" FontSize="11.5"/>
                        <TextBlock x:Name="TxtStatusCofreModal" Text="Dica: Selecione 1 item para editar ou segure Ctrl/Shift para excluir vários de uma vez." Foreground="#8AA4C0" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗑 EXCLUIR REGISTRO(S) SELECIONADO(S)" Style="{StaticResource NeonRedButton}" Click="BtnExcluirSelecionados_Click" Margin="0,0,12,0"/>
                        <Button Content="✔ FECHAR E ATUALIZAR PAINEL" Style="{StaticResource NeonCyanButton}" Click="BtnFechar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

