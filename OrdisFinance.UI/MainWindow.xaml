<Window x:Class="OrdisFinance.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ORDIS // TERMINAL FINANCEIRO NEURAL v2.7" Icon="pack://application:,,,/ordis_icon.ico" Height="780" Width="1260"
        WindowStyle="None" ResizeMode="CanResize"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        Background="#08080C" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Consolas, Segoe UI" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="#060609" BorderBrush="#152232" BorderThickness="1" CornerRadius="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="BarraNeon" CornerRadius="4" Margin="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00F0FF" Offset="0.0"/>
                                                            <GradientStop Color="#00FF66" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BarraNeon" Property="Background" Value="#00FF66"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#102536"/>
                                <Setter Property="Foreground" Value="#00FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF0055"/>
                                <Setter Property="Foreground" Value="#08080C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonGreenButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.8" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00FF66" Offset="0.0"/>
                                    <GradientStop Color="#00E5FF" Offset="0.5"/>
                                    <GradientStop Color="#007733" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect x:Name="SombraBrilho" Color="#00FF66" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="SombraBrilho" Storyboard.TargetProperty="Opacity" From="0.35" To="0.75" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#0D2216"/>
                                <Setter TargetName="BordaNeon" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF66" BlurRadius="22" ShadowDepth="0" Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#B3FFD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonCyanButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.8" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00F0FF" Offset="0.0"/>
                                    <GradientStop Color="#7000FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect x:Name="SombraBrilho" Color="#00F0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="SombraBrilho" Storyboard.TargetProperty="Opacity" From="0.3" To="0.7" Duration="0:0:2.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#0B1C26"/>
                                <Setter TargetName="BordaNeon" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F0FF" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonRedButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.8" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0055" Offset="0.0"/>
                                    <GradientStop Color="#FF6600" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect x:Name="SombraBrilho" Color="#FF0055" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="SombraBrilho" Storyboard.TargetProperty="Opacity" From="0.3" To="0.7" Duration="0:0:1.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#260B15"/>
                                <Setter TargetName="BordaNeon" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF0055" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BordaCombo" Background="#060609" BorderBrush="#1F293A" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00F0FF"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BordaCombo" Property="BorderBrush" Value="#00F0FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,5,24,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#08080C" BorderThickness="1" BorderBrush="#00F0FF" CornerRadius="4">
                                        <ScrollViewer Margin="2">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#08080C"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D2636"/>
                                <Setter Property="Foreground" Value="#00FF66"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#102A1E"/>
                                <Setter Property="Foreground" Value="#00FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1A2636" BorderThickness="1" Background="#08080C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE TITULO ESCURA CUSTOMIZADA -->
            <Border Grid.Row="0" Background="#050508" BorderBrush="#142030" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown" Padding="14,0,8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0A1F14" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="$" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/></Border>
                        <TextBlock Text="ORDIS // TERMINAL FINANCEIRO NEURAL v2.7" Foreground="#6C849E" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource TitleBarControlButton}" Click="BtnMinimizarJanela_Click" ToolTip="Minimizar"/>
                        <Button Content="▢" Style="{StaticResource TitleBarControlButton}" Click="BtnMaximizarJanela_Click" ToolTip="Maximizar / Restaurar"/>
                        <Button Content="✖" Style="{StaticResource TitleBarCloseButton}" Click="BtnFecharJanela_Click" ToolTip="Encerrar Terminal"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CORPO PRINCIPAL DO PROGRAMA -->
            <Grid Grid.Row="1" Margin="18,10,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CABECALHO COM IDENTIDADE DINAMICA (COFRE XXX-YYYY) E RELOGIO CYBERPUNK AO VIVO -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="CEPHALON ORDIS // FINANCIAL MATRIX" Foreground="#00F0FF" FontSize="22" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtIdentidadeCofre" Text="COFRE XXX-YYYY: CONECTADO // OPERADOR" Foreground="#00FF66" FontSize="12" FontWeight="Bold"
                                       Cursor="Hand" MouseLeftButtonDown="TxtIdentidadeCofre_MouseLeftButtonDown"
                                       />
                            <TextBlock Text="  •  " Foreground="#3A506B" FontSize="12"/>
                            <TextBlock x:Name="TxtStatusCofre" Text="SISTEMA PRONTO" Foreground="#5A728A" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PAINEL DIREITO: BOTOES FURTIVO/TRANCAR + CRONOMETRO CYBERPUNK COM SEGUNDOS AO VIVO -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnUpdateOnline" Content="☁ ATUALIZAR (v2.7)" Style="{StaticResource NeonGreenButton}" Click="BtnUpdateOnline_Click" Padding="10,6" FontSize="11" Margin="0,0,8,0" ToolTip="Verificar e instalar atualizações online via GitHub"/>
                        <Button x:Name="BtnModoFurtivo" Content="👁 FURTIVO" Style="{StaticResource NeonCyanButton}" Click="BtnModoFurtivo_Click" Padding="10,6" FontSize="11" Margin="0,0,8,0" ToolTip="Ocultar ou exibir todos os valores em R$ na tela"/>
                        <Button Content="🔒 TRANCAR" Style="{StaticResource NeonRedButton}" Click="BtnTrancarTerminal_Click" Padding="10,6" FontSize="11" Margin="0,0,12,0" ToolTip="Trancar terminal e exigir senha"/>

                        <Border Background="#0A0E17" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="5" Padding="12,5">
                            <Border.Effect>
                                <DropShadowEffect Color="#00F0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="LedPulsoRelogio" Width="7" Height="7" Fill="#00FF66" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtDataCyberpunk" Text="TER // 10.NOV.2026" Foreground="#8AA4C0" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtHoraMinutoCyber" Text="00:00" Foreground="#00F0FF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSegundosCyber" Text=":00" Foreground="#00F0FF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- PAINEL DO MINI-ORDIS + RADAR SAZONAL E CAIXINHAS AMPLIADO E LEGIVEL -->
                <Border Grid.Row="1" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ESCUDO MENSAL -->
                        <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTituloEscudo" Text="STATUS DO ESCUDO MENSAL" Foreground="#00FF66" FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtConselhoOrdis" Text="Carregando telemetria..." Foreground="#D0E8FF" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <ProgressBar x:Name="BarraCaixa" Height="12" Minimum="0" Maximum="100" Value="10" Background="#060609" Foreground="#00FF66" BorderThickness="0"/>
                        </StackPanel>

                        <!-- CAIXINHA DE RADAR SAZONAL E CAIXINHAS COM MAIS DESTAQUE E LEGIBILIDADE -->
                        <Border Grid.Column="1" Background="#08080C" BorderBrush="#00F0FF" BorderThickness="1.4" CornerRadius="6" Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="⚡ RADAR SAZONAL &amp; CAIXINHAS DE PLANEJAMENTO" Foreground="#00F0FF" FontSize="13.5" FontWeight="Bold"/>
                                    <TextBlock Text="(Duplo clique no item para abrir)" Foreground="#6C849E" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox x:Name="ListaAlertasSazonais" Grid.Row="1" Background="Transparent" Foreground="#FFB800" BorderThickness="0"
                                         Height="92" MouseDoubleClick="ListaAlertasSazonais_MouseDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBg" Background="#0D121C" BorderBrush="#1A2A3E" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                                            <TextBlock Text="{Binding}" Foreground="#FFB800" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBg" Property="Background" Value="#122234"/>
                                                                <Setter TargetName="ItemBg" Property="BorderBrush" Value="#00FF66"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- CORPO DIVIDIDO -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*"/>
                        <ColumnDefinition Width="1.18*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUNA ESQUERDA -->
                    <Border Grid.Column="0" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="95"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="FILA DE QUARENTENA (PENDENTES DE APROVACAO)" Foreground="#00F0FF" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                            
                            <ListBox x:Name="ListaQuarentena" Grid.Row="1" Background="#08080C" Foreground="#00FF66" BorderBrush="#1F293A" 
                                     DisplayMemberPath="ResumoVisual" SelectionChanged="ListaQuarentena_SelectionChanged" Margin="0,0,0,10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <!-- BARRAS DE ENTRADA / EDICAO -->
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Descrição:" Foreground="#6C849E" FontSize="11"/>
                                    <Grid>
                                        <TextBox x:Name="TxtEditDescricao" Margin="0,2,0,0"
                                                 PreviewKeyDown="TxtEditDescricao_PreviewKeyDown"
                                                 TextChanged="TxtEditDescricao_TextChanged"
                                                 ToolTip="Comece a digitar (ex: Fa, Ac, El) para autocompletar Descrição, Categoria, Pagamento e Valor!"/>
                                        <Popup x:Name="PopupAutoCompleteDescricao" PlacementTarget="{Binding ElementName=TxtEditDescricao}" Placement="Bottom"
                                               AllowsTransparency="True" StaysOpen="False" Focusable="False">
                                            <Border Background="#050508" BorderBrush="#00FF66" BorderThickness="1.5" CornerRadius="4"
                                                    MinWidth="340" MaxHeight="165">
                                                <ListBox x:Name="ListaSugestoesDescricao" Background="Transparent" Foreground="#00FF66" BorderThickness="0"
                                                         FontSize="11.5" Cursor="Hand" MouseLeftButtonUp="ListaSugestoesDescricao_MouseLeftButtonUp"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Valor (R$):" Foreground="#6C849E" FontSize="11"/>
                                    <TextBox x:Name="TxtEditValor" Margin="0,2,0,0"
                                             PreviewTextInput="TxtEditValor_PreviewTextInput"
                                             DataObject.Pasting="TxtEditValor_Pasting"
                                             TextChanged="TxtEditValor_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="Categoria:" Foreground="#6C849E" FontSize="11"/>
                                    <ComboBox x:Name="ComboEditCategoria" Margin="0,2,0,0" DropDownOpened="ComboEditCategoria_DropDownOpened"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Forma Pagamento:" Foreground="#6C849E" FontSize="11"/>
                                    <ComboBox x:Name="ComboFormaPagamento" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- BARRA INTERMEDIARIA: CATEGORIAS | + LANCAR MANUAL (QUE FAZ OS 2 TRABALHOS!) | CAIXA | COFRE -->
                            <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,12">
                                <Button Content="⚙ CATEGORIAS" Style="{StaticResource NeonCyanButton}" Click="BtnAddCategoria_Click" Margin="0,0,4,0" FontSize="11"/>
                                <Button x:Name="BtnAprovarPrincipal" Content="+ LANÇAR MANUAL" Style="{StaticResource NeonGreenButton}" Click="BtnLancamentoOuConfirmar_Click" Margin="2,0,2,0" FontSize="11" ToolTip="Confirma o arquivo selecionado na Quarentena OU cria lançamento manual direto!"/>
                                <Button Content="💰 CAIXA / HOLERITE" Style="{StaticResource NeonCyanButton}" Click="BtnSlot1_Click" Margin="2,0,2,0" FontSize="11"/>
                                <Button Content="✖ DESCARTAR" Style="{StaticResource NeonRedButton}" Click="BtnDescartar_Click" Margin="4,0,0,0" FontSize="11" ToolTip="Descartar arquivo selecionado na Quarentena"/>
                            </UniformGrid>

                            <!-- RESUMO ANALITICO -->
                            <DockPanel Grid.Row="4" LastChildFill="True" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Top" Text="RESUMO ANALITICO DO MINI-ORDIS:" Foreground="#6C849E" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPreviewBruto" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="#00F0FF" Background="#050508"/>
                            </DockPanel>

                            <!-- BARRA INFERIOR UNIFICADA: AS 4 OPCOES MOVIDAS DO TOPO + BOTAO DESCARTAR -->
                            <UniformGrid Grid.Row="5" Columns="5">
                                <Button Content="+ IMPORTAR ARQ." Style="{StaticResource NeonCyanButton}" Click="BtnImportar_Click" Margin="0,0,3,0" FontSize="10.5" ToolTip="Importar PDF, Imagem ou TXT para a Quarentena"/>
                                <Button Content="⚡ HOT-BACKUP" Style="{StaticResource NeonCyanButton}" Click="BtnBackup_Click" Margin="2,0,2,0" FontSize="10.5" ToolTip="Executar Hot-Backup Criptografado agora"/>
                                <Button Content="📅 SAZONAL" Style="{StaticResource NeonCyanButton}" Click="BtnAbrirCalendarioSazonal_Click" Margin="2,0,2,0" FontSize="10.5" ToolTip="Abrir Calendário de Eventos Sazonais"/>
                                <Button Content="🎯 CAIXINHAS" Style="{StaticResource NeonGreenButton}" Click="BtnAbrirCaixinhas_Click" Margin="2,0,3,0" FontSize="10.5" ToolTip="Abrir Caixinhas de Planejamento e Estrategista"/>
                                <Button Content="🗄 COFRE / REGISTROS" Style="{StaticResource NeonCyanButton}" Click="BtnSlot2_Click" Margin="3,0,0,0" FontSize="10.5" ToolTip="Abrir Central de Registros Confirmados no Cofre"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- COLUNA DIREITA: CENTRAL HOLOGRAFICA DE GRAFICOS -->
                    <Border Grid.Column="1" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1.15*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="TELEMETRIA MENSAL // CATEGORIAS, PAGAMENTOS &amp; GANHOS" Foreground="#00FF66" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Mês/Ano:" Foreground="#8AA4C0" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="ComboMesPizza" Width="92" SelectionChanged="FiltroPizza_SelectionChanged" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="ComboAnoPizza" Width="74" SelectionChanged="FiltroPizza_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PIZZA 1: MAIORES CATEGORIAS -->
                                <Border Grid.Column="0" Background="#08080C" BorderBrush="#162232" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="MAIORES CATEGORIAS" Foreground="#00F0FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Canvas x:Name="CanvasPizzaCategorias" Grid.Row="1" Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ItemsControl x:Name="LegendaTopCategorias" Grid.Row="2" Margin="2,6,2,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding CorBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" Foreground="#D0E8FF" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ValorFormatado}" Foreground="{Binding CorBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- PIZZA 2: METODOS DE PAGAMENTO -->
                                <Border Grid.Column="1" Background="#08080C" BorderBrush="#162232" BorderThickness="1" CornerRadius="5" Padding="7" Margin="2,0,2,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="MÉTODOS DE PAGAMENTO" Foreground="#00F0FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Canvas x:Name="CanvasPizzaPagamentos" Grid.Row="1" Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ItemsControl x:Name="LegendaTopPagamentos" Grid.Row="2" Margin="2,6,2,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding CorBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" Foreground="#D0E8FF" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ValorFormatado}" Foreground="{Binding CorBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- PIZZA 3: GANHOS POR PESSOA -->
                                <Border Grid.Column="2" Background="#08080C" BorderBrush="#162232" BorderThickness="1" CornerRadius="5" Padding="7" Margin="4,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="GANHOS POR PESSOA" Foreground="#00FF66" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Canvas x:Name="CanvasPizzaGanhosPessoa" Grid.Row="1" Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ItemsControl x:Name="LegendaTopGanhosPessoa" Grid.Row="2" Margin="2,6,2,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding CorBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" Foreground="#D0E8FF" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ValorFormatado}" Foreground="{Binding CorBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,2,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="GANHOS VS GASTOS" Foreground="#00FF66" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <Border Background="#080C14" BorderBrush="#153248" BorderThickness="1" CornerRadius="4" Padding="10,3" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Stroke="#00F0FF" StrokeThickness="2.2" Fill="#08080C" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="TxtLegendaGanhosValor" Text="Ganhos: R$ 0,00" Foreground="#00F0FF" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#14080E" BorderBrush="#48152A" BorderThickness="1" CornerRadius="4" Padding="10,3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Stroke="#FF0055" StrokeThickness="2.2" Fill="#08080C" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="TxtLegendaGastosValor" Text="Gastos: R$ 0,00" Foreground="#FF0055" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Ano:" Foreground="#8AA4C0" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="ComboAnoLinha" Width="78" SelectionChanged="FiltroLinha_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3" Background="#08080C" BorderBrush="#162232" BorderThickness="1" CornerRadius="5" Padding="6">
                                <Canvas x:Name="CanvasGraficoLinhas" SizeChanged="CanvasGraficoLinhas_SizeChanged" ClipToBounds="True"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>






