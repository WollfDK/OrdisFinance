<Window x:Class="OrdisFinance.UI.JanelaConciliacao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MINI-ORDIS // MATRIZ DE CONCILIACAO DOS 4 CARTOES" Height="760" Width="1180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" FontFamily="Consolas, Segoe UI">

    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="#060609" BorderBrush="#152232" BorderThickness="1" CornerRadius="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="BarraNeon" CornerRadius="4" Margin="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00F0FF" Offset="0.0"/>
                                                            <GradientStop Color="#00FF66" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonGreenButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.8" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00FF66" Offset="0.0"/>
                                    <GradientStop Color="#00E5FF" Offset="0.5"/>
                                    <GradientStop Color="#007733" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF66" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#0D2216"/>
                                <Setter Property="Foreground" Value="#B3FFD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonCyanButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00F0FF" Offset="0.0"/>
                                    <GradientStop Color="#7000FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#0B1C26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonRedButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.5" BorderBrush="#FF0055" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF0055"/>
                                <Setter Property="Foreground" Value="#08080C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BordaCombo" Background="#060609" BorderBrush="#1F293A" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00F0FF"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BordaCombo" Property="BorderBrush" Value="#00F0FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <Border Background="#08080C" BorderThickness="1" BorderBrush="#00F0FF" CornerRadius="4">
                                        <ScrollViewer Margin="2">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#08080C"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D2636"/>
                                <Setter Property="Foreground" Value="#00FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#08080C" BorderBrush="#00F0FF" BorderThickness="1.8" CornerRadius="6" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE TITULO ESCURA CUSTOMIZADA -->
            <Border Grid.Row="0" Background="#050508" BorderBrush="#1A2636" BorderThickness="0,0,0,1" CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown" Padding="14,0,8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" Foreground="#00FF66" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="MINI-ORDIS // MATRIZ DE CONCILIAÇÃO DOS 4 CARTÕES" Foreground="#00F0FF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✖" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCancelar_Click"/>
                </Grid>
            </Border>

            <!-- CONTEUDO DA MATRIZ -->
            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0E0E16" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MATRIZ DE DESMEMBRAMENTO // SEÇÃO 'DESPESAS DA FATURA'" Foreground="#00F0FF" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSubtituloFatura" Text="Alinhado pelo Vencimento: 07/11/2026" Foreground="#00FF66" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="Itens com [REVISAR] serão aprendidos pelo Mini-Ordis assim que você definir a categoria!" Foreground="#8AA4C0" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAuditoriaSoma" Text="FATURA: R$ 0,00 | DESPESAS: R$ 0,00" Foreground="#FFB800" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtDiferencaSoma" Text="Status de Batimento: Calculando..." Foreground="#D0E8FF" FontSize="11.5" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNovaCatModal" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="+ CRIAR NOVA CATEGORIA" Style="{StaticResource NeonCyanButton}" Click="BtnCriarCategoria_Click"/>
                    <Button Grid.Column="3" Content="+ ADICIONAR LINHA MANUAL" Style="{StaticResource NeonCyanButton}" Click="BtnAddLinhaManual_Click"/>
                </Grid>

                <Border Grid.Row="2" Background="#121622" Padding="10,6" CornerRadius="4,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="2.3*"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="INC." Foreground="#00F0FF" FontWeight="Bold" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="CARTÃO" Foreground="#00F0FF" FontWeight="Bold" FontSize="11.5"/>
                        <TextBlock Grid.Column="2" Text="ESTABELECIMENTO / MOVIMENTAÇÃO" Foreground="#00F0FF" FontWeight="Bold" FontSize="11.5"/>
                        <TextBlock Grid.Column="3" Text="PARCELA" Foreground="#00F0FF" FontWeight="Bold" FontSize="11.5"/>
                        <TextBlock Grid.Column="4" Text="VALOR (R$)" Foreground="#00F0FF" FontWeight="Bold" FontSize="11.5"/>
                        <TextBlock Grid.Column="5" Text="STATUS ORDIS" Foreground="#00F0FF" FontWeight="Bold" FontSize="11.5"/>
                        <TextBlock Grid.Column="6" Text="CATEGORIA DESTINO" Foreground="#00F0FF" FontWeight="Bold" FontSize="11.5"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#0B0B12" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="0,0,6,6" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ListaItensFatura">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0E0E16" BorderBrush="#182232" BorderThickness="0,0,0,1" Padding="6,5" Margin="0,0,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="2.3*"/>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding Incluir, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Checked="CheckItem_Changed" Unchecked="CheckItem_Changed"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CartaoFinal}" Foreground="#00F0FF" VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Margin="2,0,6,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding Estabelecimento, Mode=TwoWay}" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding ParcelaInfo, Mode=TwoWay}" Margin="0,0,8,0" Foreground="#8AA4C0"/>
                                            <TextBox Grid.Column="4" Text="{Binding ValorTexto, Mode=TwoWay}" Margin="0,0,8,0" TextChanged="TxtValorItem_TextChanged"/>
                                            <TextBlock Grid.Column="5" Text="{Binding StatusTexto}" Foreground="{Binding CorStatus}" FontWeight="Bold" VerticalAlignment="Center" FontSize="11.5" Margin="4,0,8,0"/>
                                            <ComboBox Grid.Column="6" ItemsSource="{Binding CategoriasDisponiveis}" SelectedItem="{Binding CategoriaSelecionada, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="✖ CANCELAR" Style="{StaticResource NeonRedButton}" Click="BtnCancelar_Click" Margin="0,0,12,0"/>
                    <Button Content="✔ CONSOLIDAR ITENS NO COFRE E ENSINAR MINI-ORDIS" Style="{StaticResource NeonGreenButton}" Click="BtnConsolidarFatura_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
