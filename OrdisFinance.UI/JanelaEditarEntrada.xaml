<Window x:Class="OrdisFinance.UI.JanelaEditarEntrada"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MINI-ORDIS // EDITAR ENTRADA DO CAIXA" Height="450" Width="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Consolas, Segoe UI">

    <Window.Resources>
        <Style x:Key="NeonGreenButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.8" Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00FF66" Offset="0.0"/>
                                    <GradientStop Color="#00E5FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF66" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#0D2216"/>
                                <Setter Property="Foreground" Value="#B3FFD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonRedButton" TargetType="Button">
            <Setter Property="Background" Value="#0A0A10"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordaNeon" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1.5" BorderBrush="#FF0055" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaNeon" Property="Background" Value="#260B15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF0055"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF0055"/>
                                <Setter Property="Foreground" Value="#08080C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#060609"/>
            <Setter Property="BorderBrush" Value="#1F293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BordaCombo" Background="#060609" BorderBrush="#1F293A" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00F0FF"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BordaCombo" Property="BorderBrush" Value="#00F0FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="8,5,24,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="#08080C" BorderThickness="1" BorderBrush="#00F0FF" CornerRadius="4">
                                        <ScrollViewer Margin="2">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#08080C"/>
            <Setter Property="Foreground" Value="#E0F8FF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D2636"/>
                                <Setter Property="Foreground" Value="#00FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#08080C" BorderBrush="#00F0FF" BorderThickness="1.8" CornerRadius="6" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE TITULO -->
            <Border Grid.Row="0" Background="#050508" BorderBrush="#1A2636" BorderThickness="0,0,0,1" CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="BarraTitulo_MouseLeftButtonDown" Padding="14,0,8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✎" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="MINI-ORDIS // EDITAR REGISTRO DE ENTRADA OU CONTRACHEQUE" Foreground="#00F0FF" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✖" Style="{StaticResource TitleCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCancelar_Click"/>
                </Grid>
            </Border>

            <!-- FORMULARIO DE EDICAO -->
            <StackPanel Grid.Row="1" Margin="18,14,18,8">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Nome do Titular / Origem:" Foreground="#00FF66" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="TxtEditNome" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CPF do Titular:" Foreground="#00FF66" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="TxtEditCpf" Margin="0,3,0,0" MaxLength="14"
                                 PreviewTextInput="ApenasDigitos_PreviewTextInput"
                                 TextChanged="TxtEditCpf_TextChanged"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Natureza da Entrada:" Foreground="#00F0FF" FontSize="11" FontWeight="Bold"/>
                        <ComboBox x:Name="ComboEditNatureza" SelectionChanged="ComboEditNatureza_SelectionChanged" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Descrição / Empresa:" Foreground="#8AA4C0" FontSize="11"/>
                        <TextBox x:Name="TxtEditDescricao" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Entrada:" Foreground="#00FF66" FontSize="11" FontWeight="Bold"/>
                        <TextBox x:Name="TxtEditData" Margin="0,3,0,0" MaxLength="10"
                                 PreviewTextInput="ApenasDigitos_PreviewTextInput"
                                 TextChanged="TxtEditData_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- VALORES COM CALCULO TRIANGULAR AUTOMATICO -->
                <Border Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="CÁLCULO AUTOMÁTICO ATIVO (PREENCHA QUAISQUER 2 CAMPOS PARA CALCULAR O 3º):" Foreground="#8AA4C0" FontSize="10.5" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColEditBruto" Width="*"/>
                                <ColumnDefinition x:Name="ColEditDescontos" Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="PainelEditBruto" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Valor Bruto (R$):" Foreground="#8AA4C0" FontSize="11"/>
                                <TextBox x:Name="TxtEditBruto" Margin="0,3,0,0"
                                         PreviewTextInput="ApenasDigitos_PreviewTextInput"
                                         TextChanged="CampoMoedaEdit_TextChanged"/>
                            </StackPanel>
                            <StackPanel x:Name="PainelEditDescontos" Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="INSS / Descontos (R$):" Foreground="#FFB800" FontSize="11"/>
                                <TextBox x:Name="TxtEditDescontos" Margin="0,3,0,0" Foreground="#FFB800"
                                         PreviewTextInput="ApenasDigitos_PreviewTextInput"
                                         TextChanged="CampoMoedaEdit_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LblEditLiquido" Text="VALOR LÍQUIDO REAL (R$):" Foreground="#00FF66" FontSize="11" FontWeight="Bold"/>
                                <TextBox x:Name="TxtEditLiquido" Margin="0,3,0,0" Foreground="#00FF66" FontWeight="Bold" BorderBrush="#00FF66"
                                         PreviewTextInput="ApenasDigitos_PreviewTextInput"
                                         TextChanged="CampoMoedaEdit_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RODAPE -->
            <Border Grid.Row="2" Background="#0E0E16" BorderBrush="#1A2636" BorderThickness="0,1,0,0" CornerRadius="0,0,5,5" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✖ CANCELAR" Style="{StaticResource NeonRedButton}" Click="BtnCancelar_Click" Margin="0,0,10,0"/>
                    <Button Content="✔ SALVAR ALTERAÇÕES" Style="{StaticResource NeonGreenButton}" Click="BtnSalvar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
